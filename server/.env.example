# ---- Server ----
NODE_ENV=development
PORT=5000

# Frontend origin: allowed by CORS and used in attendance / certificate QR URLs.
# Use your LAN IP (e.g. http://192.168.1.20:5173) so phones can open scanned QR links.
FRONTEND_URL=http://localhost:5173

# ---- PostgreSQL ----
# Either a full connection string (Supabase: Project Settings > Database > Connection string)...
DATABASE_URL=
# ...or individual values (used only when DATABASE_URL is empty)
PGHOST=localhost
PGPORT=5432
PGDATABASE=aurex26
PGUSER=postgres
PGPASSWORD=postgres
# Must be true for hosted Postgres that requires SSL (Supabase, Neon, Render...)
PGSSL=false

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Timezone that session dates/times are entered in (IANA name)
APP_TIMEZONE=Asia/Kolkata

# ---- Live sessions ----
# Online/hybrid sessions run inside the portal. Provider: jitsi (default) or daily.
VIDEO_PROVIDER=jitsi
# Jitsi as a Service (https://jaas.8x8.vc): App ID, the API key ID
# (vpaas-magic-cookie-.../abc123) and the downloaded private key file.
# Keep the key file in server/secrets/ (git-ignored).
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY_PATH=secrets/jaas-private.pem
# Daily.co alternative (needs a payment method on the Daily account)
DAILY_API_KEY=
# Proof of active presence: attendance is recorded at this % of the session length
PRESENCE_THRESHOLD_PERCENT=75
HEARTBEAT_INTERVAL_SECONDS=60
IDLE_TIMEOUT_SECONDS=120
# JUDGING DEMO ONLY: heartbeats every 5s count as 15 minutes, idle after 15s
PRESENCE_DEMO_MODE=false

# ---- Tamil translation ----
# Google Cloud Translation API key (console.cloud.google.com → enable "Cloud
# Translation API" → Credentials → API key). New texts are translated once and
# saved to server/i18n/ta.json; without a key only saved translations are shown.
GOOGLE_TRANSLATE_API_KEY=

# ---- Business rules ----
# Default minutes an attendance QR / code stays valid after the organizer starts it
ATTENDANCE_WINDOW_MINUTES=15
# Attendance can be started from a session's start time until this long after it ends
ATTENDANCE_CLOSE_AFTER_END_MINUTES=120
CERTIFICATE_ATTENDANCE_THRESHOLD=90
