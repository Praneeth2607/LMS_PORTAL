# ---- Server ----
NODE_ENV=development
PORT=5000

# Frontend origin: allowed by CORS and used in attendance / certificate QR URLs.
# Use your LAN IP (e.g. http://192.168.1.20:5173) so phones can open scanned QR links.
FRONTEND_URL=http://localhost:5173

# ---- PostgreSQL ----
# Either a full connection string (Supabase: Project Settings > Database > Connection string)...
DATABASE_URL=
# ...or individual values (used only when DATABASE_URL is empty)
PGHOST=localhost
PGPORT=5432
PGDATABASE=aurex26
PGUSER=postgres
PGPASSWORD=postgres
# Must be true for hosted Postgres that requires SSL (Supabase, Neon, Render...)
PGSSL=false

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Self sign-ups with this email domain become ORGANIZER (others become PARTICIPANT)
ORGANIZER_EMAIL_DOMAIN=cict.in

# ---- Business rules ----
# Default minutes an attendance QR / code stays valid after the organizer starts it
ATTENDANCE_WINDOW_MINUTES=15
CERTIFICATE_ATTENDANCE_THRESHOLD=90
