# ---- Server ----
NODE_ENV=development
PORT=5000

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Public base URL used inside certificate QR codes (verification page)
PUBLIC_VERIFY_URL=http://localhost:5173/verify

# ---- PostgreSQL ----
PGHOST=localhost
PGPORT=5432
PGDATABASE=aurex26
PGUSER=postgres
PGPASSWORD=postgres
# Optional: set true for hosted Postgres that requires SSL (Neon, Render, Supabase...)
PGSSL=false

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# ---- Business rules ----
CERTIFICATE_ATTENDANCE_THRESHOLD=90
