{
  "name": "aurex26-tech-comrades",
  "version": "0.1.0",
  "private": true,
  "description": "CICT Workshop & Learning Management Portal (Aurex'26, Track 01, PS-01)",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "db:migrate": "npm run db:migrate --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
